# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PIN auth — server-side pepper mixed into the 4-digit PIN before it becomes
# the Supabase password. Any long random string. Never expose to the client.
PIN_PEPPER=

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:counsellor@example.com

# Local dev default org timezone for reminders
REMINDER_HOUR_LOCAL=20
ORG_TIMEZONE=Asia/Kolkata
